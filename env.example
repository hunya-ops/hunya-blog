# ==========================================
# 🚀 部署基础配置 (Base Deployment)
# ==========================================
# Docker 端口映射绑定 IP (安全配置)
# - 127.0.0.1: 仅限本机访问 (推荐配合 Nginx 反向代理使用，最安全)
# - 0.0.0.0:   允许公网直接访问 (如果不使用 Nginx，需确保防火墙安全)
DOCKER_BIND=0.0.0.0

# 外部访问端口
# Docker 将把容器内的 5000 端口映射到宿主机的此端口
PORT=5000

# 运行环境: production (生产) 或 development (开发)
# 生产环境会开启安全 Cookie 等保护措施
FLASK_ENV=production


# ==========================================
# 🐳 Docker 性能调优 (Docker Optimization) (可选)
# ==========================================
# Gunicorn 工作进程数
# 推荐计算公式: (2 x CPU核心数) + 1
# 例如: 1核=3, 2核=5, 4核=9
# GUNICORN_WORKERS=4

# Gunicorn 监听地址
# 注意: 标准 Docker 网络模式必须设为 0.0.0.0，否则无法被宿主机访问
# 仅在使用 network_mode: host 时才可设为 127.0.0.1
# GUNICORN_BIND=0.0.0.0:5000


# ==========================================
# 🛡️ 管理员设置 (Admin)
# ==========================================
# 后台登录密码 (首次登录使用，登录后会自动转换为安全哈希存储)
ADMIN_PASSWORD=admin


# ==========================================
# 📝 博客站点设置 (Site Settings)
# ==========================================
# 注意：以下配置仅作为【首次初始化】时的默认值。
# 后续所有修改请直接在【后台 -> 设置 -> 基本信息】中进行，
# 数据库存储的配置优先级高于此处环境变量。

# 博客标题
BLOG_TITLE=昏鸦博客

# 博客描述/副标题
BLOG_DESCRIPTION=一个充满梦想的博客


# ==========================================
# 💾 缓存与数据库 (Cache & DB)
# ==========================================
# Redis 连接地址
# Docker 部署: 默认使用 docker-compose 中定义的 redis 服务
# 本地开发: 若本机装有 Redis，可改为 redis://localhost:6379/0
# REDIS_URL=redis://redis:6379/0


# ==========================================
# 🔑 API 与安全 (API & Security)
# ==========================================
# API 访问密钥
# 用于 iOS 快捷指令发布或第三方 Markdown 编辑器(如 MWeb/Typora)接入
# 重要: 请务必修改默认值，否则 API 功能将自动禁用
API_KEY=your-api-key-here


# ==========================================
# 🛠️ 本地开发调试 (Local Development)
# ==========================================
# 仅在运行 `python run.py` 时生效，Docker 部署不使用以下配置

# 开发服务器监听地址 (127.0.0.1 仅限本机访问)
FLASK_RUN_HOST=127.0.0.1

# 开发服务器端口
FLASK_RUN_PORT=5000

# 调试模式 (True/False)，生产环境请务必设为 False
FLASK_DEBUG=False
