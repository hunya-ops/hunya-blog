# 部署配置
DOCKER_BIND=0.0.0.0
PORT=5000
FLASK_ENV=production

# Docker 配置 (可选)
# 推荐配置: Workers = (2 x CPU核心数) + 1
# 例如 2核机器设置为 5，4核机器设置为 9
# GUNICORN_WORKERS=4
#
# Gunicorn 监听地址
# 注意: 在标准 Docker 网络模式下必须设为 0.0.0.0 才能被外部(包括宿主机)访问
# 仅在使用 network_mode: host 模式时可设为 127.0.0.1
# GUNICORN_BIND=0.0.0.0:5000

# 管理员密码
ADMIN_PASSWORD=admin

# 博客配置
BLOG_TITLE=昏鸦博客
BLOG_DESCRIPTION=一个充满梦想的博客

# 缓存配置
# Docker 部署: 默认使用 redis://redis:6379/0 (在 docker-compose.yml 中定义)
# 本地开发: 若使用本地 Redis，请取消下行注释
# REDIS_URL=redis://localhost:6379/0

# API 密钥 (用于快捷指令发布)
API_KEY=your-api-key-here

# Flask 本地运行配置 (python run.py)
FLASK_RUN_HOST=127.0.0.1
FLASK_RUN_PORT=5000
FLASK_DEBUG=False
